# Copia este archivo a .env.local y rellena con tus valores reales.
# .env.local NUNCA se commitea (ya está en .gitignore).

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para scripts server-side (migraciones, jobs). NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexión directa a Postgres — Project Settings → Database → Connection string (URI, modo "Transaction")
DATABASE_URL=

# Mapbox — Account → Tokens (token público "pk.", seguro de exponer en el cliente)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Stripe (modo test) — Dashboard → Developers → API keys. La secret key NUNCA al cliente.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Lo imprime `stripe listen` (local) o el endpoint del webhook (Vercel)
STRIPE_WEBHOOK_SECRET=
# Segundo destino de webhook (eventos de cuentas conectadas). En local es el mismo secreto que el de arriba
STRIPE_CONNECT_WEBHOOK_SECRET=

# Emails (Resend). Sin dominio verificado solo se puede enviar a la dirección de la cuenta de Resend.
RESEND_API_KEY=
# Remitente. Sin dominio propio: MatchKeeper <onboarding@resend.dev>
EMAIL_FROM=
# En desarrollo y staging: todos los emails se entregan a esta dirección (el asunto dice a quién iban). Vacío en producción
EMAIL_REDIRECT_TO=
# Quien recibe los avisos de administración
ADMIN_EMAIL=
# Vercel lo envía como Bearer al llamar a /api/cron/*. Cadena aleatoria de 16+ caracteres.
CRON_SECRET=
# URL base para los retornos del alta de Stripe. Opcional: por defecto localhost en dev y SITE_URL en producción
APP_URL=
